# Copiá este archivo como .env.local y completá los valores. .env.local no se sube a git.

# --- Sitio ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Project Settings → API Keys) ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Publishable key (sb_publishable_...) o la anon key legacy
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...) o la service_role legacy. SOLO servidor, nunca con NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# --- Twitch (https://dev.twitch.tv/console/apps) ---
# Se usan para la API Helix (antigüedad de cuenta, estado en vivo).
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_CHANNEL_LOGIN=chupetti

# Solo para Supabase local (supabase start): el mismo Client ID/Secret de Twitch.
SUPABASE_AUTH_EXTERNAL_TWITCH_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_TWITCH_SECRET=

# --- Kick (https://kick.com/settings/developer) — estado en vivo ---
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
KICK_CHANNEL_SLUG=chupetti

# --- YouTube Data API v3 (Google Cloud Console) — últimos clips ---
YOUTUBE_API_KEY=
# Opcional: si no está, se resuelve desde el handle.
YOUTUBE_CHANNEL_ID=
YOUTUBE_HANDLE=@ChupettiClips
